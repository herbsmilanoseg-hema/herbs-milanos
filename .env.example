# ──────────────────────────────────────────────────────────────────────────
# Herbs Milanos — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit your real .env file to git. It's already in .gitignore.
#
# ──────────────────────────────────────────────────────────────────────────

# ─── Resend (required for RFQ email notifications) ────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address.
# - "onboarding@resend.dev" = Resend sandbox (only sends to account owner)
# - "noreply@yourdomain.com" = use after verifying your domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives RFQ submissions.
RFQ_TO_EMAIL=herbs.milanos.eg@gmail.com

# ─── Upstash Redis (optional — for distributed rate limiting) ────────────
# When set, RFQ rate limit uses Upstash (works across multiple instances).
# When not set, falls back to in-memory (single-instance only).
# Create a free database at: https://upstash.com (10K req/day free)
# See: download/UPSTASH-SETUP.md
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# ─── Security Profile (optional) ─────────────────────────────────────────
# Set to "true" to enable the strict security profile:
#   - X-Frame-Options: DENY
#   - Cross-Origin-Opener-Policy: same-origin
#   - Cross-Origin-Resource-Policy: same-origin
#   - Tighter CSP (no unsafe-eval, frame-ancestors 'none')
# Leave unset for preview profile (allows iframe embedding).
# STRICT_SECURITY=true
